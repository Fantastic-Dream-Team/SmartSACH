# ==========================================
# VARIABLES DE ENTORNO PARA MICROSERVICIO PHP
# ==========================================

# Frontend React (URL donde se ejecuta el dashboard)
REACT_URL=http://localhost:5173

# URL pública de este microservicio PHP (para redirecciones internas)
PHP_URL=http://localhost:8080

# ==========================================
# SUPABASE (obtenidas de tu panel de Supabase)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==========================================
# BASE DE DATOS POSTGRESQL (conexión directa)
# ==========================================
DB_HOST=your-db-host
DB_PORT=5432
DB_DATABASE=postgres
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# ==========================================
# JWT 
# ==========================================
JWT_SECRET=your-jwt-secret